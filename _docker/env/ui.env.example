# Audit Rail — UI container environment.
# Copy to ui.env. Read at CONTAINER START by _docker/ui/entrypoint.sh, so changing it in
# Portainer and restarting is enough — nothing is baked into the JavaScript bundle.

# ── API_URL — the nginx UPSTREAM this container forwards /api to ────────────────────────
#
# Two supported deployments. Pick one:
#
#   1. This container forwards /api onward — one upstream in your nginx instead of two:
#
#        API_URL=http://audit-rail-api:5007       (same docker network — see below)
#        API_URL=http://10.0.0.12:5007            (different host)
#
#   2. Your own nginx routes /api straight to the API container. Then this container needs to
#      forward nothing: leave API_URL empty and the /api block is simply not written.
#
# For (1) the two containers must share a network. The compose files declare `audit-rail` as
# EXTERNAL for exactly this reason; `service_ctl.sh up` creates it, or by hand:
#
#     docker network create audit-rail
#
# NO trailing slash and NO path: nginx must forward the URI unchanged, because the FastAPI
# routers are mounted at /api. The entrypoint strips a trailing slash for you and logs the
# upstream it settled on, so `docker logs audit-rail-ui` tells you which mode you are in.
#
# ── What this must never become ─────────────────────────────────────────────────────────
#
# A different ORIGIN handed to the frontend. It is tempting — GINTI's webui does exactly that,
# writing window.__env__ and letting axios hold an absolute base URL — but this app cannot:
#
#   * the public signing page fetches /api/sign/... with a hardcoded root-relative path and
#     never touches the axios instance,
#   * the logo, evidence previews and asset photos are blob fetches carrying a bearer header,
#     which a plain <img src> cannot do, and
#   * stored document HTML contains literal /api/documents/images/<uuid> srcs that are hashed
#     into content_sha256, frozen on publish and signed — so they can never be rewritten.
#
# Forwarding at the EDGE keeps all three true. A base URL in the bundle breaks the first two
# and permanently corrupts the third.
API_URL=http://audit-rail-api:5007
