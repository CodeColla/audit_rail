# Audit Rail — API container environment.
# Copy to api.env and fill in. Portainer: Stack -> Editor -> environment variables.

# ── Database (yours, already running) ───────────────────────────────────────────────────
# Apply _docker/host.sql to it ONCE before the first start. The driver is psycopg 3, hence
# the +psycopg. Use the container-reachable host, not localhost, unless the API runs with
# network_mode: host.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db.internal:5432/audit_rail

# ── Secrets ─────────────────────────────────────────────────────────────────────────────
# MUST be set. The default is a public string in the repo, and anyone who has it can mint a
# token for any user in any tenant. The app only prints a warning and starts anyway.
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_HOURS=12

# ── Deployment mode (Phase 10 — Enterprise licensing) ───────────────────────────────────
# "public" (default): this is the shared multi-tenant SaaS — leave it unset. "enterprise":
# a standalone, single-tenant deployment (the customer's own infra, or a dedicated
# instance on ours) entitled by a signed license token instead of Razorpay — see
# docs/phase10/03-enterprise-licensing.md. Same Docker image either way; nothing else in
# this file changes between the two modes.
# DEPLOYMENT_MODE=enterprise
#
# The PUBLIC half of the RSA keypair scripts/issue_license.py signs with — it ships
# baked into the image at api/license_public_key.pem already, so this almost never needs
# overriding. Change it only if you've generated a genuinely different keypair for this
# deployment specifically (uncommon — one keypair normally serves every customer).
# LICENSE_PUBLIC_KEY_PATH=/app/api/license_public_key.pem
#
# How long a license (or a brand-new, never-yet-licensed deployment) keeps running at full
# limits past expiry/onboarding before usage is frozen at its current level.
# LICENSE_GRACE_DAYS=30

# ── Razorpay (Phase 10, S3a) — Public mode only; a "enterprise" deployment never reads
# these, and a "public" one with them left empty just 503s every billing route instead of
# crashing (api/routers/billing.py). Use test (rzp_test_…) values until S4/go-live.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Generated by Razorpay when the webhook is configured in their dashboard — a value THEY
# generate for you there, never derived from the key secret above.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# Created once per environment (test vs live) by scripts/create_razorpay_plans.py, which
# prints these six lines ready to paste in.
RAZORPAY_PLAN_PRO_MONTHLY=CHANGE_ME
RAZORPAY_PLAN_PRO_YEARLY=CHANGE_ME
RAZORPAY_PLAN_ADDON_AUDITS_MONTHLY=CHANGE_ME
RAZORPAY_PLAN_ADDON_AUDITS_YEARLY=CHANGE_ME
RAZORPAY_PLAN_ADDON_STORAGE_MONTHLY=CHANGE_ME
RAZORPAY_PLAN_ADDON_STORAGE_YEARLY=CHANGE_ME
# How long a Pro subscription keeps its limits after a failed renewal charge before
# dropping to Free.
# BILLING_GRACE_DAYS=7

# ── Storage ─────────────────────────────────────────────────────────────────────────────
# Matches the volume mount in docker-compose.yml. Do not point this inside /app.
VAULT_DIR=/data/vault
MAX_UPLOAD_MB=25

# ── Behind your nginx ───────────────────────────────────────────────────────────────────
# CORS_ORIGINS is parsed as JSON because the setting is a List[str] — a bare
# `CORS_ORIGINS=https://ar.iam-kiam.com` will fail to parse and the app WILL NOT START.
# With the SPA and the API on one origin (your nginx routing /api) CORS is not used at all,
# but the value still has to be syntactically valid.
CORS_ORIGINS=["https://ar.iam-kiam.com"]

# Which upstream addresses uvicorn will trust X-Forwarded-* from. `*` is fine when the port
# is bound to loopback and only your nginx can reach it.
FORWARDED_ALLOW_IPS=*

# ── Scheduler ───────────────────────────────────────────────────────────────────────────
# Generates recurring tasks, flips overdue ones, retires people whose contracts ended.
# It is an in-process scheduler with no shared lock, so exactly ONE container should run it.
# With a single API container leave this true.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60

# Number of uvicorn workers. Leave at 1 while SCHEDULER_ENABLED=true — each worker starts its
# own scheduler, and they would duplicate task generation.
WEB_CONCURRENCY=1

# ── Never set this in production ────────────────────────────────────────────────────────
# E2E_TEST_HOOKS=1     mounts /api/e2e/* — test-only routes that bypass normal flows.
