# Audit Rail — API container environment.
# Copy to api.env and fill in. Portainer: Stack -> Editor -> environment variables.

# ── Database (yours, already running) ───────────────────────────────────────────────────
# Apply _docker/host.sql to it ONCE before the first start. The driver is psycopg 3, hence
# the +psycopg. Use the container-reachable host, not localhost, unless the API runs with
# network_mode: host.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db.internal:5432/audit_rail

# ── Secrets ─────────────────────────────────────────────────────────────────────────────
# MUST be set. The default is a public string in the repo, and anyone who has it can mint a
# token for any user in any tenant. The app only prints a warning and starts anyway.
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_HOURS=12

# ── Storage ─────────────────────────────────────────────────────────────────────────────
# Matches the volume mount in docker-compose.yml. Do not point this inside /app.
VAULT_DIR=/data/vault
MAX_UPLOAD_MB=25

# ── Behind your nginx ───────────────────────────────────────────────────────────────────
# CORS_ORIGINS is parsed as JSON because the setting is a List[str] — a bare
# `CORS_ORIGINS=https://ar.iam-kiam.com` will fail to parse and the app WILL NOT START.
# With the SPA and the API on one origin (your nginx routing /api) CORS is not used at all,
# but the value still has to be syntactically valid.
CORS_ORIGINS=["https://ar.iam-kiam.com"]

# Which upstream addresses uvicorn will trust X-Forwarded-* from. `*` is fine when the port
# is bound to loopback and only your nginx can reach it.
FORWARDED_ALLOW_IPS=*

# ── Scheduler ───────────────────────────────────────────────────────────────────────────
# Generates recurring tasks, flips overdue ones, retires people whose contracts ended.
# It is an in-process scheduler with no shared lock, so exactly ONE container should run it.
# With a single API container leave this true.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60

# Number of uvicorn workers. Leave at 1 while SCHEDULER_ENABLED=true — each worker starts its
# own scheduler, and they would duplicate task generation.
WEB_CONCURRENCY=1

# ── Never set this in production ────────────────────────────────────────────────────────
# E2E_TEST_HOOKS=1     mounts /api/e2e/* — test-only routes that bypass normal flows.
