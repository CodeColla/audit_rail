import { useQuery } from "@tanstack/react-query";
import { get } from "../lib/api";
import { Loading, PageHead, Pill, Table, Td } from "../lib/ui";

type Pol = { id: string; title: string; description: string | null; next_review_at: string | null; review_status: string };

export default function Policies() {
  const { data, isLoading } = useQuery({ queryKey: ["policies"], queryFn: () => get<Pol[]>("/policies") });
  if (isLoading) return <Loading />;
  const rows = data ?? [];
  return (
    <>
      <PageHead eyebrow="Policy register" title="Policies"
        lead="Every policy with an owner, an approved version, and a review cadence — so “when was this last reviewed?” always has an answer." />
      {rows.length === 0 ? <div className="rounded-xl border border-dashed border-bd bg-paper p-8 text-center text-sm text-txt3">No policies yet.</div> : (
        <Table head={["Policy", "Next review", "Status"]}>
          {rows.map((p) => (
            <tr key={p.id} className="hover:bg-canvas">
              <Td><div className="font-medium">{p.title}</div>{p.description && <div className="text-[11.5px] text-txt3">{p.description}</div>}</Td>
              <Td className="font-mono text-txt2">{p.next_review_at ?? "—"}</Td>
              <Td><Pill tone={p.review_status}>{p.review_status.replace(/_/g, " ")}</Pill></Td>
            </tr>
          ))}
        </Table>
      )}
    </>
  );
}
