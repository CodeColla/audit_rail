# Absolute URL of the deployed webui app, no trailing slash. /signup and /login are appended
# by src/lib/env.ts. Baked into the bundle at BUILD time (this is a static marketing site with
# no runtime config mechanism, unlike the UI container's nginx-entrypoint API_URL, which is
# read at container START) — so changing this means rebuilding the landing image, not just
# restarting the container.
VITE_APP_URL=https://app.auditrail.example.com

# Enterprise's "Talk to sales" CTA and the legal pages' contact address are mailto: links, not
# a form post — there's no backend for this static site to post to. Same build-time caveat as
# VITE_APP_URL above.
VITE_SALES_EMAIL=sales@auditrail.example.com

# Shown on the Contact page — Razorpay requires a phone number there before it will activate
# an account (req/phase10/00-issue-19.md). Same build-time caveat as above.
VITE_CONTACT_PHONE=+91 00000 00000
