# Absolute URL of the deployed webui's signup page. Baked into the bundle at BUILD time (this
# is a static marketing site with no runtime config mechanism, unlike the UI container's
# nginx-entrypoint API_URL, which is read at container START) — so changing this means
# rebuilding the landing image, not just restarting the container.
VITE_SIGNUP_URL=https://app.auditrail.example.com/signup

# Enterprise's "Talk to sales" CTA is a mailto: link, not a form post — there's no backend
# for this static site to post to. Same build-time caveat as VITE_SIGNUP_URL above.
VITE_SALES_EMAIL=sales@auditrail.example.com
