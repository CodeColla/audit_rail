# audit_rail — copy to .env and adjust. Defaults in api/config.py work for local dev.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL via docker-compose.yml. NOTE the host port is 5433, not 5432 —
# Probo's stack already holds 5432 on this machine.
# DATABASE_URL=postgresql+psycopg://audit:audit@localhost:5433/audit_rail

# ── API server ──────────────────────────────────────────────────────────────
# API_HOST=127.0.0.1
# API_PORT=5007
# CORS_ORIGINS=["http://localhost:3002"]

# Mandatory outside local dev:
# JWT_SECRET=change-me-to-a-real-secret-at-least-32-bytes-long

# ── Evidence vault (local disk; S3-compatible later) ─────────────────────────
# VAULT_DIR=/home/sumit/SR/audit_rail/data/vault
# MAX_UPLOAD_MB=25

# ── Recurring-task scheduler ────────────────────────────────────────────────
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_MINUTES=60
